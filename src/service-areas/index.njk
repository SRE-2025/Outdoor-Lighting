---
layout: layouts/base.njk
title: "Service Areas — Outdoor Lighting Across Hays County"
description: "Excel Outdoor Lighting Co. serves Buda, Kyle, San Marcos, Dripping Springs, Wimberley, Driftwood and the surrounding Austin area with permanent, landscape, holiday & commercial lighting."
---
{% import "partials/icons.njk" as ico %}
{% import "partials/media.njk" as media %}
{% set totalCities = (locations.priority | length) + (locations.additional | length) %}

<section class="hero hero--page">
  <div class="wrap">
    <div class="hero__inner">
      <p class="hero__tagline">{{ site.tagline }}</p>
      <h1>Outdoor lighting across Hays County &amp; beyond</h1>
      <p class="hero__sub">Based in Buda and serving {{ totalCities }} communities across Hays County and the surrounding Austin area — from San Marcos up through South Austin and the Hill Country. Wherever you are, you get the same trusted local team.</p>
      <div class="hero__actions">
        <a class="btn btn--primary btn--lg" href="/contact/">Get a Free Consultation</a>
      </div>
    </div>
  </div>
</section>

<nav class="wrap crumbs"><a href="/">Home</a><span>/</span>Service Areas</nav>

<section class="section">
  <div class="wrap">
    <div class="center narrow" style="margin:0 auto 40px">
      <p class="eyebrow">Priority corridor</p>
      <h2>Our core service cities</h2>
      <p class="lead">These are the communities we serve most — click through for local details.</p>
    </div>
    <figure class="media reveal" style="max-width:900px;margin:0 auto 34px">{{ media.image("areas", "Outdoor lighting for homes and businesses across Hays County") }}</figure>
    <div class="grid grid-4">
      {% for loc in locations.priority %}
      <a class="card card--link" href="/service-areas/{{ loc.slug }}/">
        <div class="card__icon">{{ ico.svg("pin") }}</div>
        <h3>{{ loc.city }}</h3>
        <p class="muted" style="font-size:.9rem">{{ loc.county }}</p>
        <span class="card__more">{{ loc.city }} lighting {{ ico.svg("arrow") }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--soft">
  <div class="wrap center">
    <p class="eyebrow">Full coverage</p>
    <h2>All {{ totalCities }} cities we serve</h2>
    <p class="lead narrow" style="margin:0 auto 28px">Don't see your city on the priority list? We likely still serve you. Here's our complete Hays-area service area.</p>
    <ul class="chips" style="justify-content:center;max-width:920px;margin:0 auto">
      {% for loc in locations.priority %}
      <li><a class="chip chip--strong" href="/service-areas/{{ loc.slug }}/" style="text-decoration:none">{{ loc.city }}</a></li>
      {% endfor %}
      {% for city in locations.additional %}
      <li class="chip">{{ city }}</li>
      {% endfor %}
    </ul>
    <p class="muted" style="margin-top:24px">Not sure if we reach you? <a href="/contact/">Just ask</a> — if we can't help, we'll point you to someone who can.</p>
  </div>
</section>

{% include "partials/cta.njk" %}
