---
layout: layouts/base.njk
title: "Contact — Free Landscaping Estimate in Central Texas"
description: "Request a free landscape design estimate from Excel Lawn Care. Family-owned, serving Buda, Kyle, San Marcos & Central Texas. Call (512) 233-6300."
---
{% import "partials/icons.njk" as ico %}

<section class="hero hero--page">
  <div class="wrap">
    <div class="hero__inner">
      <p class="hero__tagline">Free estimates · No pressure</p>
      <h1>Let's talk about your landscape</h1>
      <p class="hero__sub">Tell us what you have in mind and we'll set up a free, on-site consultation — with the owner, not a call center.</p>
    </div>
  </div>
</section>

<nav class="wrap crumbs"><a href="/">Home</a><span>/</span>Contact</nav>

<section class="section">
  <div class="wrap split" style="align-items:start">
    <div>
      <p class="eyebrow">Request an estimate</p>
      <h2>Get your free consultation</h2>
      <p class="muted">Prefer to talk now? Call or text us at <a href="tel:{{ site.phoneRaw }}"><strong>{{ site.phone }}</strong></a> during business hours.</p>

      <div class="contact-options">
        <a class="btn btn--primary btn--lg" href="tel:{{ site.phoneRaw }}">{{ ico.svg("phone") }} Call {{ site.phone }}</a>
        <a class="btn btn--ghost btn--lg" href="sms:{{ site.phoneRaw }}">Text {{ site.phone }}</a>
      </div>
      <p class="form__note" style="margin-top:18px">Call or text for a free estimate. We’ll confirm a convenient on-site consultation time.</p>
    </div>

    <aside>
      <div class="card">
        <h3 style="margin-top:0">Get in touch</h3>
        <ul class="checks" style="gap:16px">
          <li>{{ ico.svg("phone") }} <span><strong>Phone / Text</strong><br><a href="tel:{{ site.phoneRaw }}">{{ site.phone }}</a></span></li>
          <li>{{ ico.svg("pin") }} <span><strong>Office</strong><br>{{ site.address.street }}<br>{{ site.address.city }}, {{ site.address.state }} {{ site.address.zip }}</span></li>
          <li>{{ ico.svg("clock") }} <span><strong>Hours</strong><br>{% for h in site.hours %}{{ h.days }}: {{ h.open }}{% if h.close %}–{{ h.close }}{% endif %}<br>{% endfor %}</span></li>
        </ul>
      </div>
      <div class="card" style="margin-top:22px">
        <div class="badges">
          <span class="badge">{{ ico.svg("star") }} 5.0★ Google</span>
          <span class="badge">{{ ico.svg("shield") }} BBB {{ site.trust.bbbRating }}</span>
        </div>
        <p class="muted" style="margin:14px 0 0">Family-owned since {{ site.parentFounded }} · Licensed &amp; insured · Free, no-pressure estimates.</p>
      </div>
      <div class="card" style="margin-top:22px">
        <div class="brandbar brandbar--pest"></div>
        <h3 style="margin-top:0">Need pest control?</h3>
        <p class="muted">Our sister company handles pest, termite &amp; rodent service.</p>
        <a class="btn btn--navy" href="{{ site.sister.url }}" rel="noopener">Excel Pest &amp; Lawn {{ ico.svg("arrow") }}</a>
      </div>
    </aside>
  </div>
</section>
