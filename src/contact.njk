---
layout: layouts/base.njk
title: "Contact — Free Outdoor Lighting Consultation, Buda TX"
description: "Request a free outdoor lighting consultation from Excel Outdoor Lighting Co. Family-owned, serving Buda, Kyle, San Marcos & Hays County. Call (512) 291-5900."
---
{% import "partials/icons.njk" as ico %}
{% import "partials/media.njk" as media %}

<section class="hero hero--page">
  <div class="wrap">
    <div class="hero__inner">
      <p class="hero__tagline">Free consultations · No pressure</p>
      <h1>Let's talk about your lighting</h1>
      <p class="hero__sub">Tell us what you have in mind and we'll set up a free, on-site consultation — with the owner, not a call center.</p>
    </div>
  </div>
</section>

<nav class="wrap crumbs"><a href="/">Home</a><span>/</span>Contact</nav>

<section class="section">
  <div class="wrap split" style="align-items:start">
    <div>
      <p class="eyebrow">Request a consultation</p>
      <h2>Get your free consultation</h2>
      <p class="muted">Share a few project details and we’ll open a ready-to-send text to our local team. You review it before anything is sent.</p>

      <form class="form card" id="sms-lead-form" data-phone="{{ site.phoneRaw }}">
        <div class="form__row">
          <div>
            <label for="lead-name">Name</label>
            <input id="lead-name" name="name" type="text" autocomplete="name" required>
          </div>
          <div>
            <label for="lead-city">City or ZIP</label>
            <input id="lead-city" name="city" type="text" autocomplete="postal-code" required>
          </div>
        </div>
        <div style="margin-top:16px">
          <label for="lead-service">What would you like illuminated?</label>
          <select id="lead-service" name="service" required>
            <option value="">Choose a service</option>
            {% for cat in serviceCategories %}<option value="{{ cat.name }}">{{ cat.name }}</option>{% endfor %}
            <option value="Not sure yet">Not sure yet</option>
          </select>
        </div>
        <div style="margin-top:16px">
          <label for="lead-details">Project details</label>
          <textarea id="lead-details" name="details" placeholder="Tell us about the property, areas you want lit, and your ideal timing."></textarea>
        </div>
        <button class="btn btn--primary btn--lg" type="submit" style="margin-top:16px;width:100%">Text My Project Details</button>
        <p class="form__note">This opens your text-message app with the details filled in. Nothing is sent until you tap Send.</p>
        <p class="form__status" id="sms-lead-status" role="status" aria-live="polite"></p>
      </form>

      <div class="contact-options" style="margin-top:18px">
        <a class="btn btn--ghost btn--lg" href="tel:{{ site.phoneRaw }}">{{ ico.svg("phone") }} Call {{ site.phone }}</a>
        <a class="btn btn--ghost btn--lg" href="sms:{{ site.phoneRaw }}">Send a Quick Text</a>
      </div>
    </div>

    <aside>
      <figure class="media reveal" style="margin-bottom:22px">{{ media.image("contact", "Schedule a professional outdoor lighting consultation") }}</figure>
      <div class="card">
        <h3 style="margin-top:0">Get in touch</h3>
        <ul class="checks" style="gap:16px">
          <li>{{ ico.svg("phone") }} <span><strong>Phone / Text</strong><br><a href="tel:{{ site.phoneRaw }}">{{ site.phone }}</a></span></li>
          <li>{{ ico.svg("pin") }} <span><strong>Office</strong><br>{{ site.address.street }}<br>{{ site.address.city }}, {{ site.address.state }} {{ site.address.zip }}</span></li>
          <li>{{ ico.svg("clock") }} <span><strong>Hours</strong><br>{% for h in site.hours %}{{ h.days }}: {{ h.open }}{% if h.close %}–{{ h.close }}{% endif %}<br>{% endfor %}</span></li>
        </ul>
      </div>
      <div class="card" style="margin-top:22px">
        <div class="badges">
          <span class="badge">{{ ico.svg("star") }} 5.0★ Google</span>
          <span class="badge">{{ ico.svg("shield") }} Insured &amp; bonded</span>
        </div>
        <p class="muted" style="margin:14px 0 0">Family-owned · Insured &amp; bonded · Free, no-pressure consultations.</p>
      </div>
      <div class="card" style="margin-top:22px">
        <div class="brandbar brandbar--pest"></div>
        <h3 style="margin-top:0">Need pest control?</h3>
        <p class="muted">Our sister company handles pest, termite &amp; rodent service.</p>
        <a class="btn btn--navy" href="{{ site.sister.url }}" rel="noopener">Excel Pest &amp; Lawn {{ ico.svg("arrow") }}</a>
      </div>
    </aside>
  </div>
</section>
