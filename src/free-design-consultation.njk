{% import "partials/icons.njk" as ico %}

<section class="hero hero--page">
  <div class="wrap">
    <div class="hero__inner">
      <p class="hero__tagline">No pressure. No call center.</p>
      <h1>Book your free design consultation</h1>
      <p class="hero__sub">Tell us about your yard and we'll set up a free on-site visit with the owner — a real plan and a clear estimate before you commit to anything.</p>
      <div class="hero__actions">
        <a class="btn btn--primary btn--lg" href="/contact/">Get My Free Consultation</a>
        <a class="btn btn--white btn--lg" href="tel:{{ site.phoneRaw }}">{{ ico.svg("phone") }} {{ site.phone }}</a>
      </div>
    </div>
  </div>
</section>

<nav class="wrap crumbs"><a href="/">Home</a><span>/</span>Free Design Consultation</nav>

<section class="section">
  <div class="wrap split">
    <div class="prose">
      <p class="eyebrow">What to expect</p>
      <h2>How the consultation works</h2>
      <ul class="checks">
        <li>{{ ico.svg("check") }} <span><strong>We come to you.</strong> We walk your property, look at sun, soil and drainage, and listen to how you want to use the space.</span></li>
        <li>{{ ico.svg("check") }} <span><strong>You talk to the owner.</strong> Not a salesperson — the person who'll actually design the project.</span></li>
        <li>{{ ico.svg("check") }} <span><strong>You get a plan and a clear estimate.</strong> No surprises, no obligation.</span></li>
        <li>{{ ico.svg("check") }} <span><strong>It's genuinely free.</strong> If we're not the right fit, we'll say so.</span></li>
      </ul>
      <p class="muted" style="margin-top:14px">Serving Buda, Kyle, San Marcos, Dripping Springs, Wimberley and the whole Central Texas corridor — with the same family-owned crews we've run since {{ site.parentFounded }}.</p>
    </div>
    <div>
      <div class="card">
