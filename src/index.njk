---
layout: layouts/base.njk
title: "Outdoor Lighting in Buda, Kyle & Hays County, TX"
description: "Excel Outdoor Lighting Co. designs & installs permanent outdoor lighting, landscape lighting, holiday lighting & commercial lighting across Buda, Kyle, San Marcos & Hays County. Family-owned, insured & bonded. 5-star rated. Free consultations."
---
{% import "partials/icons.njk" as ico %}
{% import "partials/media.njk" as media %}

<section class="hero">
  <div class="hero__media" aria-hidden="true">{{ media.image("home-hero", "", "hero__image", "eager") }}</div>
  <div class="wrap">
    <div class="hero__inner">
      <p class="hero__tagline">{{ site.tagline }}</p>
      <h1>Outdoor lighting that transforms your property after dark.</h1>
      <p class="hero__sub">Permanent, landscape, holiday and commercial lighting — beautifully designed, professionally installed, and built to last. Family-owned in Buda and serving all of Hays County.</p>
      <div class="hero__actions">
        <a class="btn btn--primary btn--lg" href="/contact/">Get a Free Consultation</a>
        <a class="btn btn--white btn--lg" href="/services/">Explore Lighting</a>
      </div>
      <div class="hero__trust">
        <span>{{ ico.svg("star") }} <b>5.0★</b> Google rated</span>
        <span>{{ ico.svg("shield") }} <b>Insured</b> &amp; bonded</span>
        <span>{{ ico.svg("bulb") }} <b>{{ site.experience }} years</b> of lighting experience</span>
      </div>
    </div>
  </div>
</section>

<div class="trustbar">
  <div class="wrap">
    <div class="trustbar__row">
      <span>{{ ico.svg("bulb") }} Design → Install → Enjoy</span>
      <span>{{ ico.svg("shield") }} Fully insured &amp; bonded</span>
      <span>{{ ico.svg("clock") }} Free consults in <b>24–48 hrs</b></span>
      <span>{{ ico.svg("award") }} <b>1-yr labor</b> · 5-yr parts warranty</span>
    </div>
  </div>
</div>

<!-- Intro / positioning -->
<section class="section">
  <div class="wrap split">
    <div>
      <p class="eyebrow">Who we are</p>
      <h2>Custom outdoor lighting, done right the first time.</h2>
      <p class="lead">Excel Outdoor Lighting Co. is a family-owned lighting company based in Buda. We design and install professional exterior lighting across Hays County — and we back every install with real warranties and real service.</p>
      <p>Our team brings over 20 years of exterior-lighting experience to every project. We design the system around your property, install it cleanly with concealed wiring and weatherproof LED fixtures, and stay on to service it — so it looks incredible on night one and every night after.</p>
      <ul class="checks mt-2">
        <li>{{ ico.svg("check") }} <span><strong>Permanent &amp; landscape lighting</strong> designed for your home</span></li>
        <li>{{ ico.svg("check") }} <span><strong>Warm, low-glare LED</strong> — beautiful, efficient and long-lasting</span></li>
        <li>{{ ico.svg("check") }} <span><strong>Fully insured &amp; bonded</strong>, with a 1-year labor warranty</span></li>
      </ul>
    </div>
    <div>
      <figure class="media reveal">
        {{ media.image("home-intro", "Custom landscape lighting on a Central Texas stone path") }}
        <figcaption class="media__label">Custom lighting, designed around your property</figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- Services -->
<section class="section section--soft">
  <div class="wrap">
    <div class="center narrow" style="margin:0 auto 44px">
      <p class="eyebrow">What we do</p>
      <h2>Lighting for every part of your property</h2>
      <p class="lead">From always-on permanent lighting to a full landscape design or a professional holiday display — one local team designs, installs and services it all.</p>
    </div>
    <div class="grid grid-3 grid--center">
      {% for c in serviceCategories %}
        <a class="card card--link" href="/services/{{ c.slug }}/">
          <figure class="card__photo">{{ media.image("home-category-" + c.slug, c.name + " by Excel Outdoor Lighting") }}</figure>
          <div class="card__body">
          <div class="card__icon card__icon--lg">{{ ico.svg(c.icon) }}</div>
          <h3>{{ c.name }}</h3>
          <p class="muted">{{ c.short }}</p>
          <span class="card__more">
            {% if c.subs.length > 1 %}{{ c.subs.length }} services{% else %}Learn more{% endif %} {{ ico.svg("arrow") }}
          </span>
          </div>
        </a>
      {% endfor %}
    </div>
    <div class="center" style="margin-top:32px">
      <a class="btn btn--ghost" href="/services/">See all our lighting services {{ ico.svg("arrow") }}</a>
    </div>
  </div>
</section>

<!-- Stats -->
<section class="section section--dark">
  <div class="wrap">
    <div class="stats">
      <div class="stat"><div class="stat__n">{{ site.experience }}</div><div class="stat__l">Years of lighting experience</div></div>
      <div class="stat"><div class="stat__n">5.0★</div><div class="stat__l">Google review rating</div></div>
      <div class="stat"><div class="stat__n">5-yr</div><div class="stat__l">Parts warranty on permanent lighting</div></div>
      <div class="stat"><div class="stat__n">{{ (locations.priority | length) + (locations.additional | length) }}</div><div class="stat__l">Hays-area communities served</div></div>
    </div>
  </div>
</section>

<!-- Permanent lighting highlight -->
<section class="section">
  <div class="wrap split">
    <div>
      <figure class="media reveal">
        {{ media.image("home-permanent", "Warm permanent eave lighting on a Central Texas home") }}
        <figcaption class="media__label">Permanent lighting for every occasion</figcaption>
      </figure>
    </div>
    <div>
      <p class="eyebrow">Permanent outdoor lighting</p>
      <h2>Never hang a strand of lights again.</h2>
      <p class="lead">Our permanent lighting tucks a channel of app-controlled, full-color LEDs under your eaves. Invisible by day, it delivers warm accent light every night and full holiday color on command — no ladders, no takedown, ever.</p>
      <p>It's the one upgrade that pays you back all year: better curb appeal, more safety, and a holiday display that's ready at the tap of a button.</p>
      <a class="btn btn--primary" href="/services/permanent-outdoor-lighting/">Explore Permanent Lighting {{ ico.svg("arrow") }}</a>
    </div>
  </div>
</section>

<!-- Process -->
<section class="section">
  <div class="wrap">
    <div class="center narrow" style="margin:0 auto 44px">
      <p class="eyebrow">How we work</p>
      <h2>Design → Install → Enjoy</h2>
      <p class="lead">One team, one point of contact, from the free consultation to years of easy service. Simple and done right.</p>
    </div>
    <div class="grid grid-3 process">
      <div class="process__item">
        <div class="process__num">1</div>
        <h3>Design</h3>
        <p class="muted">We visit your property for a free consultation, learn what you want to light and why, and design a system around your home — then send a detailed written estimate.</p>
      </div>
      <div class="process__item">
        <div class="process__num">2</div>
        <h3>Install</h3>
        <p class="muted">Our own crew installs clean, weatherproof LED fixtures with concealed wiring, dials in the aim and scenes, and walks you through the app before we leave.</p>
      </div>
      <div class="process__item">
        <div class="process__num">3</div>
        <h3>Enjoy</h3>
        <p class="muted">You enjoy the lighting — and we stay on to service it, with a 1-year labor warranty and a 5-year parts warranty on permanent lighting.</p>
      </div>
    </div>
  </div>
</section>

<!-- Reviews (scrolling) -->
<section class="section section--soft">
  <div class="wrap">
    <div class="center narrow" style="margin:0 auto 36px">
      <p class="eyebrow">What customers say</p>
      <h2>A perfect 5.0★ rating</h2>
      <p class="lead">Hays County homeowners and businesses trust us to light their properties — here's what a few of them had to say.</p>
    </div>
  </div>
  <div class="reviews-marquee" aria-label="Customer reviews">
    <div class="reviews-track">
      {% for r in reviews.featured %}
      <figure class="review-card">
        <div class="review__stars">★★★★★</div>
        <blockquote>"{{ r.quote }}"</blockquote>
        <figcaption><span class="review__author">{{ r.author }}</span><span class="review__context"> · {{ r.context }}</span></figcaption>
      </figure>
      {% endfor %}
      {# duplicate set for seamless looping #}
      {% for r in reviews.featured %}
      <figure class="review-card" aria-hidden="true">
        <div class="review__stars">★★★★★</div>
        <blockquote>"{{ r.quote }}"</blockquote>
        <figcaption><span class="review__author">{{ r.author }}</span><span class="review__context"> · {{ r.context }}</span></figcaption>
      </figure>
      {% endfor %}
    </div>
  </div>
  <div class="wrap center" style="margin-top:34px">
    <a class="btn btn--primary btn--lg" href="{{ site.social.google }}" target="_blank" rel="noopener">{{ ico.svg("star") }} Leave us a Google review</a>
  </div>
</section>

<!-- Service areas -->
<section class="section">
  <div class="wrap center">
    <p class="eyebrow">Where we work</p>
    <h2>Proudly serving Hays County &amp; beyond</h2>
    {% set totalCities = (locations.priority | length) + (locations.additional | length) %}
    <p class="lead narrow" style="margin:0 auto 28px">From our Buda shop across Kyle, San Marcos, Dripping Springs and the surrounding Hill Country — {{ totalCities }} communities and counting.</p>
    <ul class="chips" style="justify-content:center;max-width:940px;margin:0 auto">
      {% for loc in locations.priority %}
      <li><a class="chip chip--strong" href="/service-areas/{{ loc.slug }}/" style="text-decoration:none">{{ loc.city }}</a></li>
      {% endfor %}
      <li><a class="chip" href="/service-areas/" style="text-decoration:none">+ {{ locations.additional | length }} more communities</a></li>
    </ul>
  </div>
</section>

<!-- FAQ -->
<section class="section section--soft">
  <div class="wrap">
    <div class="center narrow" style="margin:0 auto 40px">
      <p class="eyebrow">Good to know</p>
      <h2>Frequently asked questions</h2>
    </div>
    <div class="faq">
      {% for f in faqs %}
      <details{% if loop.first %} open{% endif %}>
        <summary>{{ f.q }}</summary>
        <p>{{ f.a }}</p>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for f in faqs %}
    {
      "@type": "Question",
      "name": {{ f.q | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ f.a | dump | safe }} }
    }{{ "," if not loop.last }}
    {% endfor %}
  ]
}
</script>

{% set ctaHeading = "Ready to light up your property?" %}
{% include "partials/cta.njk" %}
