---
layout: layouts/base.njk
title: "Landscape Design, Build & Turf Care in Buda, TX"
description: "Research Turf Management designs, builds & maintains water-wise landscapes across Buda, Kyle, San Marcos & Central Texas. Family-owned since 1998. 5-star rated. Free estimates."
---
{% import "partials/icons.njk" as ico %}
{% import "partials/scene.njk" as scn %}
{% import "partials/photo.njk" as photo %}

<section class="hero">
  <div class="wrap">
    <div class="hero__inner">
      <p class="hero__tagline">{{ site.tagline }}</p>
      <h1>Central Texas landscapes, designed &amp; built to thrive.</h1>
      <p class="hero__sub">From native-plant designs and pergolas to turf that stays green through a Hill Country August — Research Turf Management is the family-owned crew Buda has trusted since {{ site.parentFounded }}.</p>
      <div class="hero__actions">
        <a class="btn btn--primary btn--lg" href="/contact/">Get a Free Estimate</a>
        <a class="btn btn--white btn--lg" href="/services/">Our Services</a>
      </div>
      <div class="hero__trust">
        <span>{{ ico.svg("star") }} <b>5.0★</b> Google rated</span>
        <span>{{ ico.svg("shield") }} <b>{{ site.trust.bbbRating }}</b> BBB accredited</span>
        <span>{{ ico.svg("pin") }} <b>{{ (locations.priority | length) + (locations.additional | length) }} cities</b> served</span>
      </div>
    </div>
  </div>
</section>

<div class="trustbar">
  <div class="wrap">
    <div class="trustbar__row">
      <span>{{ ico.svg("award") }} Family-owned since <b>{{ site.parentFounded }}</b></span>
      <span>{{ ico.svg("check") }} Design → Build → Maintain</span>
      <span>{{ ico.svg("shield") }} Licensed &amp; insured</span>
      <span>{{ ico.svg("star") }} <b>10% off</b> for military, first responders, nurses &amp; teachers</span>
    </div>
  </div>
</div>

<!-- Intro / positioning -->
<section class="section">
  <div class="wrap split">
    <div>
      <p class="eyebrow">Who we are</p>
      <h2>One trusted crew for your entire landscape.</h2>
      <p class="lead">We don't hand your yard off to subcontractors. The same family-owned team designs your landscape, builds it, and keeps it healthy season after season — which is why our customers stay with us for 13, 20, even 30 years.</p>
      <p>Owner Gye Hutson is an Austin native who has spent his whole life reading Central Texas soil, sun, and drought. Research Turf Management brings that hard-won local knowledge to every design — beautiful, water-wise, and built for the way you actually live outdoors.</p>
      <ul class="checks mt-2">
        <li>{{ ico.svg("check") }} <span><strong>Native &amp; water-wise plantings</strong> suited to Hays County soil and restrictions</span></li>
        <li>{{ ico.svg("check") }} <span><strong>High-craft hardscape</strong> — pergolas, patios, masonry &amp; stonework</span></li>
        <li>{{ ico.svg("check") }} <span><strong>Ongoing turf management</strong> from a team that studies turf</span></li>
      </ul>
    </div>
    <div>
      <figure class="media media--tall reveal">
        {{ photo.image("garden", "Water-wise Central Texas landscape by Research Turf Management") }}
        <span class="media__label">Native Hill Country design · Buda, TX</span>
      </figure>
    </div>
  </div>
</section>

<!-- Services -->
<section class="section section--soft">
  <div class="wrap">
    <div class="center narrow" style="margin:0 auto 44px">
      <p class="eyebrow">What we do</p>
      <h2>Design, build &amp; maintenance under one roof</h2>
      <p class="lead">Whether you need a full landscape transformation or steady, dependable upkeep, it's the same reliable crew from start to finish.</p>
    </div>
    <div class="grid grid-3">
      {% for c in serviceCategories %}
        <a class="card card--link" href="/services/{{ c.slug }}/">
          <div class="card__photo">{{ photo.image(c.photo, c.name + " in Central Texas") }}</div>
          <div class="card__body">
          <div class="card__icon">{{ ico.svg(c.icon) }}</div>
          <h3>{{ c.name }}</h3>
          <p class="muted">{{ c.short }}</p>
          <span class="card__more">
            {% if c.subs.length > 1 %}{{ c.subs.length }} services{% else %}Learn more{% endif %} {{ ico.svg("arrow") }}
          </span>
          </div>
        </a>
      {% endfor %}
    </div>
    <div class="center" style="margin-top:32px">
      <a class="btn btn--ghost" href="/services/">See all our services {{ ico.svg("arrow") }}</a>
    </div>
  </div>
</section>

<!-- Stats -->
<section class="section section--dark">
  <div class="wrap">
    <div class="stats">
      <div class="stat"><div class="stat__n">{{ site.yearsInBusiness }}</div><div class="stat__l">Years serving Central Texas</div></div>
      <div class="stat"><div class="stat__n">5.0★</div><div class="stat__l">Google review rating</div></div>
      <div class="stat"><div class="stat__n">{{ site.trust.bbbRating }}</div><div class="stat__l">BBB accredited since {{ site.trust.bbbAccreditedYear }}</div></div>
      <div class="stat"><div class="stat__n">{{ (locations.priority | length) + (locations.additional | length) }}</div><div class="stat__l">Central Texas cities served</div></div>
    </div>
  </div>
</section>

<!-- Hardscape highlight (the big opportunity from the brief) -->
<section class="section">
  <div class="wrap split">
    <div>
      <figure class="media reveal">
        {{ photo.image("outdoor", "Outdoor living space and hardscape in Central Texas") }}
        <span class="media__label">Pergola &amp; patio · Hays County</span>
      </figure>
    </div>
    <div>
      <p class="eyebrow">More than mow-and-blow</p>
      <h2>We build the backyard, not just the lawn.</h2>
      <p class="lead">Pergolas, patio extensions, masonry, stone borders, fresh sod, mulch and gravel — the high-craft outdoor-living work our long-time customers rave about.</p>
      <p>If you want a backyard you actually spend time in — a shaded pergola, an extended patio for the whole family, stonework that ties it all together — this is exactly the work we love most.</p>
      <a class="btn btn--primary" href="/services/pergolas-outdoor-living/">Explore Pergolas &amp; Outdoor Living {{ ico.svg("arrow") }}</a>
    </div>
  </div>
</section>

<!-- Process -->
<section class="section">
  <div class="wrap">
    <div class="center narrow" style="margin:0 auto 44px">
      <p class="eyebrow">How we work</p>
      <h2>Design → Build → Maintain</h2>
      <p class="lead">One team, one point of contact, from the first sketch to the hundredth mow. Nothing gets lost in a handoff.</p>
    </div>
    <div class="grid grid-3 process">
      <div class="process__item">
        <div class="process__num">1</div>
        <h3>Design</h3>
        <p class="muted">We walk your property, read your soil and sun, and draw a water-wise plan built for your lot, your budget, and how you want to live outdoors.</p>
      </div>
      <div class="process__item">
        <div class="process__num">2</div>
        <h3>Build</h3>
        <p class="muted">Our own crew installs it — plantings, sod, beds, and hardscape like pergolas and patios — with the soil prep and craft that make it last.</p>
      </div>
      <div class="process__item">
        <div class="process__num">3</div>
        <h3>Maintain</h3>
        <p class="muted">We keep it thriving season after season with turf management, trimming, and irrigation care. The same faces, year after year.</p>
      </div>
    </div>
  </div>
</section>

<!-- Reviews (scrolling) -->
<section class="section section--soft">
  <div class="wrap">
    <div class="center narrow" style="margin:0 auto 36px">
      <p class="eyebrow">What neighbors say</p>
      <h2>Trusted for decades, not months</h2>
      <p class="lead">A perfect 5.0★ rating across {{ reviews.aggregate.reviewCount }} reviews — from customers who've stayed with us for 13, 20, even 30 years.</p>
    </div>
  </div>
  <div class="reviews-marquee" aria-label="Customer reviews">
    <div class="reviews-track">
      {% for r in reviews.featured %}
      <figure class="review-card">
        <div class="review__stars">★★★★★</div>
        <blockquote>"{{ r.quote }}"</blockquote>
        <figcaption><span class="review__author">{{ r.author }}</span><span class="review__context"> · {{ r.context }}</span></figcaption>
      </figure>
      {% endfor %}
      {# duplicate set for seamless looping #}
      {% for r in reviews.featured %}
      <figure class="review-card" aria-hidden="true">
        <div class="review__stars">★★★★★</div>
        <blockquote>"{{ r.quote }}"</blockquote>
        <figcaption><span class="review__author">{{ r.author }}</span><span class="review__context"> · {{ r.context }}</span></figcaption>
      </figure>
      {% endfor %}
    </div>
  </div>
  <div class="wrap center" style="margin-top:34px">
    <a class="btn btn--primary btn--lg" href="{{ site.social.google }}" target="_blank" rel="noopener">{{ ico.svg("star") }} Leave us a Google review</a>
  </div>
</section>

<!-- Service areas -->
<section class="section">
  <div class="wrap center">
    <p class="eyebrow">Where we work</p>
    <h2>Proudly serving the Central Texas corridor</h2>
    {% set totalCities = (locations.priority | length) + (locations.additional | length) %}
    <p class="lead narrow" style="margin:0 auto 28px">From our Buda shop north to Hutto &amp; Liberty Hill and south to San Marcos — {{ totalCities }} cities across Hays, Travis, Williamson and the Hill Country.</p>
    <ul class="chips" style="justify-content:center;max-width:940px;margin:0 auto">
      {% for loc in locations.priority %}
      <li><a class="chip chip--strong" href="/service-areas/{{ loc.slug }}/" style="text-decoration:none">{{ loc.city }}</a></li>
      {% endfor %}
      <li><a class="chip" href="/service-areas/" style="text-decoration:none">+ {{ locations.additional | length }} more cities</a></li>
    </ul>
  </div>
</section>

<!-- FAQ -->
<section class="section section--soft">
  <div class="wrap">
    <div class="center narrow" style="margin:0 auto 40px">
      <p class="eyebrow">Good to know</p>
      <h2>Frequently asked questions</h2>
    </div>
    <div class="faq">
      {% for f in faqs %}
      <details{% if loop.first %} open{% endif %}>
        <summary>{{ f.q }}</summary>
        <p>{{ f.a }}</p>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for f in faqs %}
    {
      "@type": "Question",
      "name": {{ f.q | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ f.a | dump | safe }} }
    }{{ "," if not loop.last }}
    {% endfor %}
  ]
}
</script>

{% set ctaHeading = "Ready to grow something beautiful?" %}
{% include "partials/cta.njk" %}
