---
layout: layouts/base.njk
title: "Outdoor Lighting in Buda, Kyle & Hays County, TX"
description: "Excel Outdoor Lighting Co. designs & installs permanent outdoor lighting, landscape lighting, holiday lighting & commercial lighting across Buda, Kyle, San Marcos & Hays County. Family-owned, insured & bonded. 5-star rated. Free consultations."
---
{% import "partials/icons.njk" as ico %}
{% import "partials/media.njk" as media %}

<section class="hero">
  <div class="hero__media" aria-hidden="true">{{ media.image("home-hero", "", "hero__image", "eager") }}</div>
  <div class="wrap">
    <div class="hero__inner">
      <p class="hero__tagline">{{ site.tagline }}</p>
      <h1>Outdoor lighting that transforms your property after dark.</h1>
      <p class="hero__sub">Permanent, landscape, holiday and commercial lighting — beautifully designed, professionally installed, and built to last. Family-owned in Buda and serving all of Hays County.</p>
      <div class="hero__actions">
        <a class="btn btn--primary btn--lg" href="/contact/">Get a Free Consultation</a>
        <a class="btn btn--white btn--lg" href="/services/">Explore Lighting</a>
      </div>
      <div class="hero__trust">
        <span>{{ ico.svg("star") }} <b>5.0★</b> Google rated</span>
        <span>{{ ico.svg("shield") }} <b>Insured</b> &amp; bonded</span>
        <span>{{ ico.svg("bulb") }} <b>{{ site.experience }} years</b> of lighting experience</span>
      </div>
    </div>
  </div>
</section>

<div class="trustbar">
  <div class="wrap">
    <div class="trustbar__row">
      <span>{{ ico.svg("bulb") }} Design → Install → Enjoy</span>
      <span>{{ ico.svg("shield") }} Fully insured &amp; bonded</span>
      <span>{{ ico.svg("clock") }} Free consults in <b>24–48 hrs</b></span>
      <span>{{ ico.svg("award") }} <b>1-yr labor</b> · 5-yr parts warranty</span>
    </div>
  </div>
</div>

<!-- Intro / positioning: centered statement + credentials -->
<section class="section">
  <div class="wrap narrow center" style="margin:0 auto">
    <p class="eyebrow">Who we are</p>
    <h2>Custom outdoor lighting, done right the first time.</h2>
    <p class="lead">Excel Outdoor Lighting Co. is a family-owned lighting company based in Buda. Our team brings over 20 years of exterior-lighting experience to every project — we design the system around your property, install it cleanly with concealed wiring and weatherproof LED fixtures, and stay on to service it for years.</p>
  </div>
  <div class="wrap creds">
    <div class="cred"><span class="cred__n">{{ site.experience }}</span><span class="cred__l">Years of lighting experience</span></div>
    <div class="cred"><span class="cred__n">5.0★</span><span class="cred__l">Google review rating</span></div>
    <div class="cred"><span class="cred__n">Insured</span><span class="cred__l">Fully insured &amp; bonded</span></div>
    <div class="cred"><span class="cred__n">5-yr</span><span class="cred__l">Parts warranty on permanent lighting</span></div>
  </div>
</section>

<!-- Services as editorial rows with real project imagery -->
<section class="section section--soft">
  <div class="wrap center narrow" style="margin:0 auto 40px">
    <p class="eyebrow">What we do</p>
    <h2>Five ways we light a property</h2>
    <p class="lead">From always-on permanent lighting to a full landscape design or a professional holiday display — one local team designs, installs and services it all.</p>
  </div>
  <div class="wrap feature-rows">
    {% for c in serviceCategories %}
    <article class="feature-row reveal">
      <a class="feature-row__img" href="/services/{{ c.slug }}/" aria-label="{{ c.name }}">{{ media.image("home-category-" + c.slug, c.name + " by Excel Outdoor Lighting") }}</a>
      <div class="feature-row__body">
        <span class="feature-row__num">{{ "0" }}{{ loop.index }}</span>
        <h3><a href="/services/{{ c.slug }}/">{{ c.name }}</a></h3>
        <p class="muted">{{ c.short }}</p>
        <div class="feature-row__subs">
          {% for slug in c.subs %}
            {% for s in services %}{% if s.slug == slug %}
            <a class="chip" href="/services/{{ s.slug }}/" style="text-decoration:none">{{ s.name }}</a>
            {% endif %}{% endfor %}
          {% endfor %}
        </div>
      </div>
      <div class="feature-row__cta">
        <a class="btn btn--ghost" href="/services/{{ c.slug }}/">Explore {{ ico.svg("arrow") }}</a>
      </div>
    </article>
    {% endfor %}
  </div>
</section>

<!-- Stats -->
<section class="section section--dark">
  <div class="wrap">
    <div class="stats">
      <div class="stat"><div class="stat__n">{{ site.experience }}</div><div class="stat__l">Years of lighting experience</div></div>
      <div class="stat"><div class="stat__n">5.0★</div><div class="stat__l">Google review rating</div></div>
      <div class="stat"><div class="stat__n">5-yr</div><div class="stat__l">Parts warranty on permanent lighting</div></div>
      <div class="stat"><div class="stat__n">{{ (locations.priority | length) + (locations.additional | length) }}</div><div class="stat__l">Hays-area communities served</div></div>
    </div>
  </div>
</section>

<!-- Permanent lighting spotlight — full-bleed image band -->
<section class="spotlight">
  <div class="spotlight__media" aria-hidden="true">{{ media.image("home-permanent", "", "spotlight__img") }}</div>
  <div class="wrap narrow center spotlight__inner">
    <p class="eyebrow">Permanent outdoor lighting</p>
    <h2>Never hang a strand of lights again.</h2>
    <p class="lead" style="color:#EAF0F7">Our permanent lighting tucks a channel of app-controlled, full-color LEDs under your eaves. Invisible by day, it delivers warm accent light every night and full holiday color on command — no ladders, no takedown, ever.</p>
    <div class="pill-row">
      <span class="pill">{{ ico.svg("bulb") }} Warm white nightly</span>
      <span class="pill">{{ ico.svg("star") }} Team colors on game day</span>
      <span class="pill">{{ ico.svg("award") }} Full holiday scenes</span>
    </div>
    <a class="btn btn--primary btn--lg" href="/services/permanent-outdoor-lighting/" style="margin-top:26px">Explore Permanent Lighting {{ ico.svg("arrow") }}</a>
  </div>
</section>

<!-- Approved project video -->
<section class="section section--soft">
  <div class="wrap split">
    <div>
      <p class="eyebrow">See the difference after dark</p>
      <h2>Lighting designed for the way your property actually looks at night.</h2>
      <p class="lead">Watch Excel Outdoor Lighting's approved project video to see the clean roofline detail, warm architectural glow, and professional finish behind the work.</p>
      <a class="btn btn--primary" href="/contact/">Plan Your Lighting Project {{ ico.svg("arrow") }}</a>
    </div>
    <div class="video-frame reveal">
      <video controls preload="metadata" playsinline aria-label="Excel Outdoor Lighting project video">
        <source src="https://videos.hibustudio.com/2025/excel-outdoor-lighting-co-7131632601.mp4" type="video/mp4">
        Your browser does not support this video. <a href="https://www.exceloutdoorlightingtx.com/hibu-video-splash">Watch it on Excel Outdoor Lighting</a>.
      </video>
    </div>
  </div>
</section>

<!-- Process — horizontal steps -->
<section class="section">
  <div class="wrap center narrow" style="margin:0 auto 44px">
    <p class="eyebrow">How we work</p>
    <h2>Design → Install → Enjoy</h2>
    <p class="lead">One team, one point of contact, from the free consultation to years of easy service.</p>
  </div>
  <div class="wrap process-line">
    <div class="process-line__step"><span class="process-line__num">1</span><h3>Design</h3><p class="muted">A free in-home consultation, then a system designed around your property and a detailed written estimate.</p></div>
    <div class="process-line__step"><span class="process-line__num">2</span><h3>Install</h3><p class="muted">Our own crew installs weatherproof LED fixtures with concealed wiring and sets up your app before we leave.</p></div>
    <div class="process-line__step"><span class="process-line__num">3</span><h3>Enjoy</h3><p class="muted">You enjoy the lighting — and we service it, with a 1-year labor and 5-year parts warranty.</p></div>
  </div>
</section>

<!-- Reviews — static grid -->
<section class="section section--soft">
  <div class="wrap center narrow" style="margin:0 auto 36px">
    <p class="eyebrow">What customers say</p>
    <h2>A perfect 5.0★ rating</h2>
  </div>
  <div class="wrap reviews-grid">
    {% for r in reviews.featured %}
    <figure class="review-card">
      <div class="review__stars">★★★★★</div>
      <blockquote>"{{ r.quote }}"</blockquote>
      <figcaption><span class="review__author">{{ r.author }}</span><span class="review__context"> · {{ r.context }}</span></figcaption>
    </figure>
    {% endfor %}
  </div>
  <div class="wrap center" style="margin-top:32px">
    <a class="btn btn--ghost" href="{{ site.social.google }}" target="_blank" rel="noopener">{{ ico.svg("star") }} Read &amp; leave Google reviews</a>
  </div>
</section>

<!-- Service areas -->
<section class="section">
  <div class="wrap center">
    <p class="eyebrow">Where we work</p>
    <h2>Proudly serving Hays County &amp; beyond</h2>
    {% set totalCities = (locations.priority | length) + (locations.additional | length) %}
    <p class="lead narrow" style="margin:0 auto 28px">From our Buda shop across Kyle, San Marcos, Dripping Springs and the surrounding Hill Country — {{ totalCities }} communities and counting.</p>
    <ul class="chips" style="justify-content:center;max-width:940px;margin:0 auto">
      {% for loc in locations.priority %}
      <li><a class="chip chip--strong" href="/service-areas/{{ loc.slug }}/" style="text-decoration:none">{{ loc.city }}</a></li>
      {% endfor %}
      <li><a class="chip" href="/service-areas/" style="text-decoration:none">+ {{ locations.additional | length }} more communities</a></li>
    </ul>
  </div>
</section>

<!-- FAQ -->
<section class="section section--soft">
  <div class="wrap">
    <div class="center narrow" style="margin:0 auto 40px">
      <p class="eyebrow">Good to know</p>
      <h2>Frequently asked questions</h2>
    </div>
    <div class="faq">
      {% for f in faqs %}
      <details{% if loop.first %} open{% endif %}>
        <summary>{{ f.q }}</summary>
        <p>{{ f.a }}</p>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for f in faqs %}
    {
      "@type": "Question",
      "name": {{ f.q | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ f.a | dump | safe }} }
    }{{ "," if not loop.last }}
    {% endfor %}
  ]
}
</script>

{% set ctaHeading = "Ready to light up your property?" %}
{% include "partials/cta.njk" %}
