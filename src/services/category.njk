---
layout: layouts/base.njk
pagination:
  data: serviceCategories
  size: 1
  alias: cat
  addAllPagesToCollections: true
permalink: "/services/{{ cat.slug }}/"
eleventyComputed:
  title: "{{ cat.name | safe }} in Buda, Kyle & Central Texas"
  description: "{{ cat.short | safe }} Family-owned, licensed & insured. Serving Buda, Kyle, San Marcos & Central Texas. Free estimates from Research Turf Management."
  schema:
    "@context": "https://schema.org"
    "@type": "Service"
    serviceType: "{{ cat.name | safe }}"
    provider:
      "@type": "LandscapingBusiness"
      name: "Research Turf Management"
    areaServed: "Central Texas"
    description: "{{ cat.short | safe }}"
---
{% import "partials/icons.njk" as ico %}
{% import "partials/photo.njk" as photo %}
{% import "partials/scene.njk" as scn %}

<section class="hero hero--page">
  <div class="wrap">
    <div class="hero__inner">
      <p class="hero__tagline">{{ cat.name }}</p>
      <h1>{{ cat.name }} in Central Texas</h1>
      <p class="hero__sub">{{ cat.short }}</p>
      <div class="hero__actions">
        <a class="btn btn--primary btn--lg" href="/contact/">Get a Free Estimate</a>
        <a class="btn btn--white btn--lg" href="tel:{{ site.phoneRaw }}">{{ ico.svg("phone") }} {{ site.phone }}</a>
      </div>
    </div>
  </div>
</section>

<nav class="wrap crumbs"><a href="/">Home</a><span>/</span><a href="/services/">Services</a><span>/</span>{{ cat.name }}</nav>

<section class="section">
  <div class="wrap narrow reveal" style="margin:0 auto 8px">
    <p class="eyebrow">What's included</p>
    <h2>{{ cat.name }}</h2>
    <p class="lead">{{ cat.intro }}</p>
    <a class="btn btn--primary" href="/contact/">Get a Free Estimate {{ ico.svg("arrow") }}</a>
  </div>
  {% if cat.body %}
  <div class="wrap narrow prose" style="margin:28px auto 0">
    {% for sec in cat.body %}
    <h3>{{ sec.h }}</h3>
    {% for para in sec.p %}<p>{{ para | safe }}</p>{% endfor %}
    {% endfor %}
  </div>
  {% endif %}
  <div class="wrap" style="margin-top:44px">
    <div class="grid grid-3">
      {% for slug in cat.subs %}
        {% for s in services %}
          {% if s.slug == slug %}
          <a class="card card--link" href="/services/{{ s.slug }}/">
            <div class="card__body">
              <div class="card__icon">{{ ico.svg(s.icon) }}</div>
              <h3>{{ s.name }}</h3>
              <p class="muted">{{ s.short }}</p>
              <span class="card__more">Learn more {{ ico.svg("arrow") }}</span>
            </div>
          </a>
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

{% if cat.faqs %}
<section class="section section--soft">
  <div class="wrap narrow" style="margin:0 auto">
    <div class="center" style="margin-bottom:32px">
      <p class="eyebrow">Common questions</p>
      <h2>{{ cat.name }} FAQs</h2>
    </div>
    <div class="faq">
      {% for item in cat.faqs %}
      <details{% if loop.first %} open{% endif %}>
        <summary>{{ item.q }}</summary>
        <p>{{ item.a | safe }}</p>
      </details>
      {% endfor %}
    </div>
  </div>
</section>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in cat.faqs %}{
      "@type": "Question",
      "name": {{ item.q | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} }
    }{{ "," if not loop.last }}{% endfor %}
  ]
}
</script>
{% endif %}

<!-- Other categories -->
<section class="section">
  <div class="wrap">
    <div class="center narrow" style="margin:0 auto 36px">
      <p class="eyebrow">More services</p>
      <h2>Explore our other services</h2>
    </div>
    <ul class="chips" style="justify-content:center;max-width:820px;margin:0 auto">
      {% for c in serviceCategories %}
        {% if c.slug != cat.slug %}
        <li><a class="chip chip--strong" href="/services/{{ c.slug }}/" style="text-decoration:none">{{ c.name }}</a></li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</section>

{% set ctaHeading = "Interested in " + (cat.name | lower) + "?" %}
{% include "partials/cta.njk" %}
