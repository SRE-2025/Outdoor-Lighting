---
layout: layouts/base.njk
pagination:
  data: services
  size: 1
  alias: service
  addAllPagesToCollections: true
permalink: "/services/{{ service.slug }}/"
tags: service
eleventyComputed:
  title: "{{ service.name | safe }} in Buda, Kyle & Central Texas"
  description: "{{ service.short | safe }} Family-owned, licensed & insured. Serving Buda, Kyle, San Marcos & Central Texas. Free estimates from Research Turf Management."
  schema:
    "@context": "https://schema.org"
    "@type": "Service"
    serviceType: "{{ service.name | safe }}"
    provider:
      "@type": "LandscapingBusiness"
      name: "Research Turf Management"
    areaServed: "Central Texas"
    description: "{{ service.short | safe }}"
---
{% import "partials/icons.njk" as ico %}
{% import "partials/scene.njk" as scn %}

<section class="hero hero--page">
  <div class="wrap">
    <div class="hero__inner">
      <p class="hero__tagline">{{ service.name }}</p>
      <h1>{{ service.hero }}</h1>
      <p class="hero__sub">{{ service.short }}</p>
      <div class="hero__actions">
        <a class="btn btn--primary btn--lg" href="/contact/">Get a Free Estimate</a>
        <a class="btn btn--white btn--lg" href="tel:{{ site.phoneRaw }}">{{ ico.svg("phone") }} {{ site.phone }}</a>
      </div>
    </div>
  </div>
</section>

<nav class="wrap crumbs"><a href="/">Home</a><span>/</span><a href="/services/">Services</a><span>/</span>{{ service.name }}</nav>

<section class="section">
  <div class="wrap split">
    <div class="prose">
      <p class="eyebrow">Overview</p>
      <h2>{{ service.name }}</h2>
      <p class="lead">{{ service.intro }}</p>
      <h3>What's included</h3>
      <ul class="checks">
        {% for f in service.features %}
        <li>{{ ico.svg("check") }} <span>{{ f }}</span></li>
        {% endfor %}
      </ul>
    </div>
    <div>
      <div class="media media--tall">
        {{ scn.scene() }}
        <span class="media__label">{{ service.name }} · Central Texas</span>
      </div>
      <div class="card" style="margin-top:22px">
        <h3 style="margin-top:0">Serving your neighborhood</h3>
        <p class="muted">Available across our full 27-city Central Texas service area, including:</p>
        <ul class="chips">
          {% for loc in locations.priority %}
          <li><a class="chip" href="/service-areas/{{ loc.slug }}/" style="text-decoration:none">{{ loc.city }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Other services -->
<section class="section section--soft">
  <div class="wrap">
    <div class="center narrow" style="margin:0 auto 36px">
      <p class="eyebrow">Explore more</p>
      <h2>Other services we offer</h2>
    </div>
    <div class="grid grid-3">
      {% for s in collections.services %}
        {% if s.data.service.slug != service.slug %}
        <a class="card card--link" href="{{ s.url }}">
          <div class="card__icon">{{ ico.svg(s.data.service.icon) }}</div>
          <h3>{{ s.data.service.name }}</h3>
          <p class="muted">{{ s.data.service.short }}</p>
          <span class="card__more">Learn more {{ ico.svg("arrow") }}</span>
        </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% set ctaHeading = "Interested in " + (service.name | lower) + "?" %}
{% include "partials/cta.njk" %}
