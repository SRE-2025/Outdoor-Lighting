---
layout: layouts/base.njk
title: "Outdoor Lighting Services in Buda & Hays County, TX"
description: "Permanent outdoor lighting, landscape lighting, outdoor living space lighting, holiday lighting & commercial lighting across Buda, Kyle, San Marcos & Hays County. Free consultations."
---
{% import "partials/icons.njk" as ico %}
{% import "partials/media.njk" as media %}

<section class="hero hero--page">
  <div class="wrap">
    <div class="hero__inner">
      <p class="hero__tagline">Our Services</p>
      <h1>Outdoor lighting for every part of your property</h1>
      <p class="hero__sub">Permanent lighting, landscape lighting, outdoor living spaces, holiday displays and commercial lighting — designed, installed and serviced by one trusted local team.</p>
      <div class="hero__actions">
        <a class="btn btn--primary btn--lg" href="/contact/">Get a Free Consultation</a>
        <a class="btn btn--white btn--lg" href="tel:{{ site.phoneRaw }}">{{ ico.svg("phone") }} {{ site.phone }}</a>
      </div>
    </div>
  </div>
</section>

<nav class="wrap crumbs"><a href="/">Home</a><span>/</span>Services</nav>

<section class="section">
  <div class="wrap">
    <div class="grid grid-3 grid--center">
      {% for c in serviceCategories %}
      <a class="card card--link" href="/services/{{ c.slug }}/">
        <figure class="card__photo">{{ media.image("services-category-" + c.slug, c.name + " by Excel Outdoor Lighting") }}</figure>
        <div class="card__body">
          <div class="card__icon card__icon--lg">{{ ico.svg(c.icon) }}</div>
          <h3>{{ c.name }}</h3>
          <p class="muted">{{ c.short }}</p>
          <span class="card__more">
            {% if c.subs.length > 1 %}{{ c.subs.length }} services{% else %}Learn more{% endif %} {{ ico.svg("arrow") }}
          </span>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--soft">
  <div class="wrap split">
    <div>
      <p class="eyebrow">Design → Install → Enjoy</p>
      <h2>Why one team for all of it matters</h2>
      <p>When the people who design your lighting are also the ones who install and service it, nothing gets lost in translation. We design a system around your property, install it cleanly with weatherproof fixtures and concealed wiring, and stand behind all of it with real warranties.</p>
      <ul class="checks mt-2">
        <li>{{ ico.svg("check") }} <span>Free in-home consultation within 24–48 hours</span></li>
        <li>{{ ico.svg("check") }} <span>Residential &amp; commercial properties welcome</span></li>
        <li>{{ ico.svg("check") }} <span>Warm, low-glare, energy-efficient LED fixtures</span></li>
        <li>{{ ico.svg("check") }} <span>Fully insured &amp; bonded, warranty-backed work</span></li>
        <li>{{ ico.svg("check") }} <span>One team from design through install &amp; service</span></li>
      </ul>
    </div>
    <div>
      <div class="glowpanel reveal">
        <span class="glowpanel__icon">{{ ico.svg("bulb") }}</span>
        <p class="glowpanel__title">One team, start to finish</p>
        <p class="glowpanel__sub">Design · Install · Service · Warranty</p>
      </div>
    </div>
  </div>
</section>

{% set ctaHeading = "Not sure which lighting is right for you?" %}
{% set ctaText = "Book a free consultation and we'll design the right system for your property — permanent, landscape, holiday or commercial." %}
{% include "partials/cta.njk" %}
