{% import "partials/icons.njk" as ico %}
<section class="section">
  <div class="wrap">
    <div class="cta-band">
      <h2>{{ ctaHeading if ctaHeading else "Let's design the yard you actually want." }}</h2>
      <p>{{ ctaText if ctaText else "Free, no-pressure consultations across Buda, Kyle, San Marcos and the whole Central Texas corridor. Talk to the owner, not a call center." }}</p>
      <a class="btn btn--white btn--lg" href="/contact/">Get a Free Estimate</a>
      <a class="btn btn--ghost btn--lg" href="tel:{{ site.phoneRaw }}" style="color:#fff;border-color:rgba(255,255,255,.4)">{{ ico.svg("phone") }} {{ site.phone }}</a>
    </div>
  </div>
</section>
