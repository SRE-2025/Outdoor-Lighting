{# Deliberately small, non-repeating portfolio image set.
   Service and homepage layouts use native UI artwork rather than recycling photos. #}
{% macro image(key, alt, className="") %}
  {% set images = {
    lawn: "https://speedy.uenicdn.com/c76af982-7c11-4c2e-a0e8-7edf63746682/c1920_800a/image/upload/v1738097160/business/df0464a0fb8944919982e82d4d5fb6b0.jpg",
