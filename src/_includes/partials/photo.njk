    outdoor: "https://our.uenicdn.com/image/upload/v1738097951/business/1b607c04009e4065b5d6d95f81a0dcdb.jpg",
    care: "https://our.uenicdn.com/image/upload/v1738096202/business/8e5a6323e6cd4e5dae7af6ce14e17e28.jpg"
  } %}
  <img class="media__image {{ className }}" src="{{ images[key] }}" alt="{{ alt }}" loading="lazy" decoding="async">
{% endmacro %}
