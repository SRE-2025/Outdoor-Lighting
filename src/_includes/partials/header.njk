{% import "partials/icons.njk" as ico %}
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap nav">
    <a class="brand" href="/" aria-label="Excel Outdoor Lighting Co. — home">
      <img class="brand__logo" src="https://le-cdn.hibuwebsites.com/2c78f110716e4dddafdf2527c8c72c37/dms3rep/multi/opt/excel+outdoor+lighting+co+logo-300w.png" alt="Excel Outdoor Lighting Co.">
    </a>

    <nav aria-label="Primary">
      <ul class="nav__links" id="nav-links">
        <li class="nav__call-mobile"><a href="tel:{{ site.phoneRaw }}">{{ ico.svg("phone") }} Call {{ site.phone }}</a></li>
        <li><a href="/about/">About</a></li>
        <li class="has-dropdown">
          <a href="/services/">Services <span class="caret" aria-hidden="true">▾</span></a>
          <div class="dropdown" role="menu" aria-label="Services">
            {% for c in serviceCategories %}
            <div class="dropdown__col">
              <a class="dropdown__head" href="/services/{{ c.slug }}/">{{ c.name }}</a>
              {% for slug in c.subs %}
                {% for s in services %}{% if s.slug == slug %}
                <a class="dropdown__link" href="/services/{{ s.slug }}/">{{ s.name }}</a>
                {% endif %}{% endfor %}
              {% endfor %}
            </div>
            {% endfor %}
          </div>
        </li>
        <li><a href="/service-areas/">Service Areas</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>

    <div class="nav__cta">
      <a class="nav__phone nav__phone--desktop" href="tel:{{ site.phoneRaw }}">{{ site.phone }}</a>
      <a class="btn btn--primary" href="/contact/">Free Estimate</a>
      <button class="nav__toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-links">
        {{ ico.svg("menu") }}
      </button>
    </div>
  </div>
</header>
<div class="mobile-actions" aria-label="Quick contact actions">
  <a href="tel:{{ site.phoneRaw }}">{{ ico.svg("phone") }} Call now</a>
  <a href="/contact/">Free estimate</a>
</div>
