{%- elif name == "logo" -%}
<svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><rect x="2" y="2" width="44" height="44" rx="11" fill="#2F5D3A"/><path d="M24 38V21" stroke="#EFE7D8" stroke-width="2.2" stroke-linecap="round"/><path d="M24 27c-1.2-6-6-8.5-12-8.5 0 6 4 9.5 12 9.5Z" fill="#EFE7D8"/><path d="M24 22c1.1-5.5 5.3-7.5 10.5-7.5 0 5.5-3.3 8.5-10.5 8.5Z" fill="#B4562C"/></svg>
{%- endif -%}
{% endmacro %}
