{# Reusable inline SVG icons. Usage: {% import "partials/icons.njk" as ico %} then {{ ico.svg("leaf") }} #}
{% macro svg(name) %}
{%- if name == "leaf" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/></svg>
{%- elif name == "compass" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
{%- elif name == "sprout" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 20h10"/><path d="M12 20c0-6.5-3-9-7-9 0 4 3 7 7 8Z"/><path d="M12 20c0-4.5 2-7 6-7 0 3.5-2.5 6-6 6.5Z"/><path d="M12 20v-6"/></svg>
{%- elif name == "wall" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="M3 10h18M3 14h18M9 5v5M15 10v4M9 14v5"/></svg>
{%- elif name == "grass" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20V9"/><path d="M12 12c0-4-2-7-5-8 0 4 1 6 5 8Z"/><path d="M12 12c0-4 2-7 5-8 0 4-1 6-5 8Z"/><path d="M4 20h16"/></svg>
{%- elif name == "tree" -%}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21v-5"/><path d="M12 16a6 6 0 0 0 3.6-10.8A5 5 0 0 0 6.7 6 4.5 4.5 0 0 0 8 15a6 6 0 0 0 4 1Z"/></svg>
