{# Tasteful Hill Country landscape line-illustration used as intentional art in
   .media blocks until real project photos are added. #}
{% macro scene() %}
<svg class="scene" viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <!-- sun -->
  <circle cx="312" cy="86" r="34" fill="#ffffff" opacity="0.12"/>
  <circle cx="312" cy="86" r="22" fill="#ffffff" opacity="0.16"/>
  <!-- far hills -->
  <path d="M0 168 Q80 132 168 160 T400 150 V300 H0 Z" fill="#ffffff" opacity="0.07"/>
  <!-- mid hills -->
  <path d="M0 200 Q110 160 210 194 T400 186 V300 H0 Z" fill="#ffffff" opacity="0.10"/>
  <!-- live oak -->
  <g stroke="#ffffff" stroke-width="2" fill="none" opacity="0.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M78 232 V196 M78 210 l-16 -12 M78 204 l18 -14 M78 216 l14 -10"/>
    <path d="M50 190 q-14 -20 10 -30 q6 -22 30 -16 q22 -10 30 12 q20 6 8 26 q4 18 -20 18 q-16 12 -34 2 q-22 4 -24 -22 Z"/>
  </g>
  <!-- shrubs -->
  <g stroke="#ffffff" stroke-width="1.6" fill="#ffffff" opacity="0.28" stroke-linejoin="round">
    <path d="M150 250 q10 -26 26 -14 q16 -10 20 12 q10 0 6 16 H150 Z"/>
    <path d="M232 256 q8 -20 22 -10 q14 -6 14 12 H232 Z"/>
  </g>
  <!-- grasses -->
  <g stroke="#ffffff" stroke-width="1.6" fill="none" opacity="0.4" stroke-linecap="round">
    <path d="M300 272 q2 -18 -4 -28 M306 272 q2 -20 6 -30 M312 272 q0 -16 8 -24"/>
    <path d="M110 276 q2 -14 -3 -22 M116 276 q2 -16 5 -24"/>
  </g>
  <!-- ground line -->
  <path d="M0 260 Q140 244 260 258 T400 252" stroke="#ffffff" stroke-width="1.4" fill="none" opacity="0.35"/>
</svg>
{% endmacro %}

{# Themed category tiles — one distinct composition per service category, so the
   card grid never repeats a visual. Deep-green gradient ground with white line art. #}
{% macro art(kind, className="") %}
{% set id = "g-" + kind %}
<svg class="scene scene--art {{ className }}" viewBox="0 0 400 230" preserveAspectRatio="xMidYMid slice" role="img" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="{{ id }}" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2F5D3A"/>
      <stop offset="1" stop-color="#173C25"/>
    </linearGradient>
  </defs>
  <rect width="400" height="230" fill="url(#{{ id }})"/>
  <circle cx="330" cy="52" r="30" fill="#ffffff" opacity="0.10"/>

  {% if kind == "lawn-care" %}
    {# mowed turf stripes + a shade tree #}
    <g opacity="0.16" fill="#ffffff">
      <path d="M0 150 L400 120 V230 H0 Z"/>
    </g>
    <g stroke="#ffffff" stroke-width="2" opacity="0.32" fill="none">
      <path d="M0 168 Q120 150 400 138 M0 186 Q140 168 400 158 M0 206 Q150 190 400 180 M0 226 Q160 212 400 204"/>
    </g>
    <g stroke="#ffffff" stroke-width="2.4" fill="none" opacity="0.66" stroke-linecap="round" stroke-linejoin="round">
      <path d="M92 150 V96"/>
      <path d="M60 108 q-16 -24 12 -34 q6 -26 34 -18 q26 -12 34 14 q22 8 8 30 q4 20 -24 20 q-18 14 -38 2 q-24 4 -26 -26 Z"/>
    </g>
  {% elif kind == "misting-systems" %}
    {# mist nozzle arcs + patio edge #}
    <g stroke="#ffffff" fill="none" stroke-linecap="round">
      <g opacity="0.5" stroke-width="2">
        <path d="M70 70 q40 26 0 60"/>
        <path d="M90 64 q60 40 0 84"/>
        <path d="M110 60 q86 54 0 108"/>
      </g>
      <g opacity="0.34" stroke-width="1.6">
        <circle cx="150" cy="70" r="2.4"/><circle cx="188" cy="92" r="2.4"/>
        <circle cx="176" cy="128" r="2.4"/><circle cx="214" cy="150" r="2.4"/>
        <circle cx="150" cy="160" r="2.4"/>
      </g>
    </g>
    <g stroke="#ffffff" stroke-width="2.2" opacity="0.5" fill="none">
      <path d="M0 196 H400 M64 196 V150 M64 150 H150"/>
    </g>
    <g stroke="#ffffff" stroke-width="2" opacity="0.4" fill="none" stroke-linecap="round">
      <path d="M300 196 v-26 M312 196 v-34 M324 196 v-24"/>
    </g>
  {% elif kind == "outdoor-living" %}
    {# pergola beams + fire pit #}
    <g stroke="#ffffff" fill="none" opacity="0.6" stroke-width="2.4" stroke-linecap="round">
      <path d="M70 80 V196 M300 80 V196"/>
      <path d="M52 80 H318"/>
      <path d="M60 96 H310 M60 112 H310"/>
    </g>
    <g stroke="#ffffff" stroke-width="2.2" opacity="0.5" fill="none">
      <path d="M0 196 H400"/>
      <ellipse cx="186" cy="182" rx="34" ry="10"/>
    </g>
    <g stroke="#ffffff" fill="none" opacity="0.6" stroke-width="2" stroke-linecap="round">
      <path d="M174 176 q4 -18 12 -22 q-2 12 6 16 q6 -6 4 -16 q12 12 4 22"/>
    </g>
  {% elif kind == "sprinkler-systems" %}
    {# rotor spray arcs + zone lines #}
    <g stroke="#ffffff" fill="none" stroke-linecap="round">
      <g opacity="0.5" stroke-width="2">
        <path d="M120 168 q-46 -70 0 -110"/>
        <path d="M120 168 q-24 -78 40 -104"/>
        <path d="M120 168 q24 -70 78 -74"/>
      </g>
      <circle cx="120" cy="168" r="4" fill="#ffffff" opacity="0.7"/>
    </g>
    <g stroke="#ffffff" stroke-width="1.8" opacity="0.3" fill="none" stroke-dasharray="6 8">
      <path d="M0 200 H400 M280 200 V120 M280 120 H400"/>
    </g>
    <g stroke="#ffffff" stroke-width="2" opacity="0.42" fill="none" stroke-linecap="round">
      <path d="M300 200 v-20 M310 200 v-28 M320 200 v-18"/>
    </g>
  {% elif kind == "tree-care" %}
    {# large canopy + pruning shears motif #}
    <g stroke="#ffffff" stroke-width="2.6" fill="none" opacity="0.66" stroke-linecap="round" stroke-linejoin="round">
      <path d="M150 200 V120 M150 150 l-26 -20 M150 138 l30 -22 M150 166 l22 -16"/>
      <path d="M104 118 q-22 -30 16 -44 q8 -32 44 -22 q32 -16 44 18 q28 10 10 40 q6 26 -30 26 q-24 18 -50 2 q-30 6 -34 -20 Z"/>
    </g>
    <g stroke="#ffffff" stroke-width="2" opacity="0.5" fill="none">
      <path d="M0 200 H400"/>
    </g>
    <g stroke="#ffffff" stroke-width="2" fill="none" opacity="0.42" stroke-linecap="round">
      <path d="M300 176 l24 24 M324 176 l-24 24"/>
      <circle cx="302" cy="178" r="4"/><circle cx="322" cy="178" r="4"/>
    </g>
  {% else %}
    {{ scene() }}
  {% endif %}
</svg>
{% endmacro %}
