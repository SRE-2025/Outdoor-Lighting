{% import "partials/icons.njk" as ico %}
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <div class="footer__brand">
          <span class="brand__mark brand__mark--glow" style="width:38px;height:38px">{{ ico.svg("bulb") }}</span>
          <span class="brand__text">
            <span class="brand__name">Excel Outdoor Lighting</span>
            <span class="brand__tag">Beautifully Lit, Every Night</span>
          </span>
        </div>
        <p>Family-owned outdoor lighting design &amp; installation serving Buda, Kyle, San&nbsp;Marcos and all of Hays County.</p>
        <p class="mb-0"><strong style="color:#fff">Fully insured &amp; bonded.</strong> Free consultations. 1-yr labor &amp; 5-yr parts warranty.</p>
      </div>

      <div>
        <h4>Services</h4>
        <ul>
          {% for c in serviceCategories %}
          <li><a href="/services/{{ c.slug }}/">{{ c.name }}</a></li>
          {% endfor %}
          <li><a href="/services/"><strong>All services &rarr;</strong></a></li>
        </ul>
        <h4 style="margin-top:24px">Explore</h4>
        <ul>
          <li><a href="/about/">About Us</a></li>
          <li><a href="/process/">Our Process</a></li>
          <li><a href="/why-choose-us/">Why Choose Us</a></li>
          <li><a href="/free-design-consultation/">Free Consultation</a></li>
          <li><a href="/faqs/">FAQs</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>

      <div>
        <h4>Service Areas</h4>
        <ul class="footer-cols">
          {% for loc in locations.priority %}
            {% if loop.index <= 10 %}
            <li><a href="/service-areas/{{ loc.slug }}/">{{ loc.city }}</a></li>
            {% endif %}
          {% endfor %}
        </ul>
        <p class="mb-0" style="margin-top:6px"><a href="/service-areas/"><strong>All {{ (locations.priority | length) + (locations.additional | length) }} cities &rarr;</strong></a></p>
      </div>

      <div>
        <h4>Contact</h4>
        <ul>
          <li><a href="tel:{{ site.phoneRaw }}">{{ ico.svg("phone") }} {{ site.phone }}</a></li>
          <li>{{ site.address.street }}<br>{{ site.address.city }}, {{ site.address.state }} {{ site.address.zip }}</li>
          <li><strong style="color:#fff">Mon–Fri 8am–5pm</strong></li>
        </ul>
        <p style="margin-top:14px">
          Need pest control? Visit our sister company<br>
          <a href="{{ site.sister.url }}" rel="noopener"><strong>Excel Pest &amp; Lawn Control &rarr;</strong></a>
        </p>
      </div>
    </div>

    <div class="footer__legal">
      <span>&copy; {{ "now" | year }} {{ site.name }}. All rights reserved.</span>
      <span>Buda, TX &middot; {{ site.address.county }} &middot; Design → Install → Enjoy</span>
    </div>
  </div>
</footer>
