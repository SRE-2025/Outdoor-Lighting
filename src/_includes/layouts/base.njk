<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {% set pageTitle = title if title else site.name %}
  {% set fullTitle = pageTitle + " | " + site.shortName if title else site.name + " — " + site.tagline %}
  <title>{{ fullTitle }}</title>

  {% set metaDesc = description if description else site.description %}
  <meta name="description" content="{{ metaDesc }}">
  {% set canonical = (page.url | absoluteUrl(site.url)) %}
  <link rel="canonical" href="{{ canonical }}">
  <meta name="robots" content="index, follow, max-image-preview:large">
  <meta name="theme-color" content="#2F5D3A">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ fullTitle }}">
  <meta property="og:description" content="{{ metaDesc }}">
  <meta property="og:url" content="{{ canonical }}">
  <meta property="og:locale" content="en_US">
  {% set ogImage = (ogImage if ogImage else "/assets/img/og-default.svg") | absoluteUrl(site.url) %}
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ fullTitle }}">
  <meta name="twitter:description" content="{{ metaDesc }}">
  <meta name="twitter:image" content="{{ ogImage }}">

  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/assets/img/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;700&display=swap">
  <link rel="preload" href="/assets/css/style.css" as="style">
  <link rel="stylesheet" href="/assets/css/style.css">

  {# ---- LocalBusiness structured data (sitewide) ---- #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LandscapingBusiness",
    "@id": "{{ site.url }}/#business",
    "name": "{{ site.name }}",
    "alternateName": "Research Turf Mgmt",
    "slogan": "{{ site.tagline }}",
    "description": "{{ site.description }}",
    "url": "{{ site.url }}",
    "telephone": "{{ site.phone }}",
    "foundingDate": "{{ site.parentFounded }}",
    "priceRange": "$$",
    "image": "{{ site.url }}/assets/img/og-default.svg",
    "logo": "{{ site.url }}/assets/img/favicon.svg",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "{{ site.address.street }}",
      "addressLocality": "{{ site.address.city }}",
      "addressRegion": "{{ site.address.state }}",
      "postalCode": "{{ site.address.zip }}",
      "addressCountry": "US"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": {{ site.geo.lat }},
      "longitude": {{ site.geo.lng }}
    },
    "openingHoursSpecification": [
      {% for h in site.openingHoursSpec %}
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": {{ h.dayOfWeek | dump | safe }},
        "opens": "{{ h.opens }}",
        "closes": "{{ h.closes }}"
      }{{ "," if not loop.last }}
      {% endfor %}
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "{{ reviews.aggregate.rating }}",
      "reviewCount": "{{ reviews.aggregate.reviewCount }}"
    },
    "areaServed": [
      {% for loc in locations.priority %}{ "@type": "City", "name": "{{ loc.city }}, TX" }{{ "," if not loop.last }}{% endfor %}
    ],
    "sameAs": [
      "{{ site.social.facebook }}",
      "{{ site.social.youtube }}"
    ]
  }
  </script>
  {% if schema %}<script type="application/ld+json">{{ schema | dump | safe }}</script>{% endif %}
</head>
<body>
  {% include "partials/header.njk" %}
  <main id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  <script src="/assets/js/main.js" defer></script>
</body>
</html>
